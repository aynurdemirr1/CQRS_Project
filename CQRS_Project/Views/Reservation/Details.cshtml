@* Views/Reservation/Details.cshtml *@

@{
    ViewData["Title"] = "Rezervasyon Detayları";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="main-panel">
    <div class="content-wrapper">
        <div class="row">
            <div class="col-lg-12 grid-margin stretch-card">
                <div class="card">
                    <div class="card-body">

                        @await Component.InvokeAsync("ReservationSummary", new
                            {
                                carId = (int)ViewBag.CarId,
                                brand = (string)ViewBag.Brand,
                                model = (string)ViewBag.Model,
                                fuelType = (string)ViewBag.FuelType,
                                pricePerDay = (decimal)ViewBag.PricePerDay,
                                totalPrice = (decimal)ViewBag.TotalPrice,
                                totalDays = (int)ViewBag.TotalDays,
                                pickUpLocationId = (int)ViewBag.PickUpLocationId,
                                dropOffLocationId = (int)ViewBag.DropOffLocationId,

                                // Tarih ve Saatler
                                startDate = (DateTime)ViewBag.StartDate,
                                endDate = (DateTime)ViewBag.EndDate,
                                startTime = (string)ViewBag.StartTime,
                                endTime = (string)ViewBag.EndTime,

                                pickUpText = (string)ViewBag.PickUpText,
                                dropOffText = (string)ViewBag.DropOffText,

                                // Hesaplanan Değerler
                                distanceKm = (double)ViewBag.DistanceKm,
                                estimatedFuelLiters = (double)ViewBag.EstimatedFuelLiters,
                                estimatedFuelCost = (decimal)ViewBag.EstimatedFuelCost,

                                // Lokasyon Koordinatları
                                pickUpLat = (double)ViewBag.PickUpLat,
                                pickUpLon = (double)ViewBag.PickUpLon,
                                dropOffLat = (double)ViewBag.DropOffLat,
                                dropOffLon = (double)ViewBag.DropOffLon
                            })

                        <div class="mt-4">
                            <a href="/Reservation/Index" class="btn btn-secondary">
                                <i class="mdi mdi-arrow-left"></i> Listeye Geri Dön
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>