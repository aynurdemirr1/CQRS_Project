@* Views/Shared/Components/ReservationSummary/Default.cshtml - PEMBE ARKA PLAN KALDIRILDI *@

@{
    // KRİTİK DÜZELTME: Bütün ViewBag değerlerini güvenli olarak okuyoruz.

    // Tarih Kontrolleri
    DateTime? safeStartDate = ViewBag.StartDate as DateTime?;
    DateTime? safeEndDate = ViewBag.EndDate as DateTime?;

    // Double Kontrolleri (Mesafe ve Yakıt Litresi)
    double? safeDistanceKm = ViewBag.DistanceKm as double?;
    double? safeEstimatedFuelLiters = ViewBag.EstimatedFuelLiters as double?;

    // Decimal Kontrolleri (Fiyatlar)
    decimal? safePricePerDay = ViewBag.PricePerDay as decimal?;
    decimal? safeTotalPrice = ViewBag.TotalPrice as decimal?;
    decimal? safeEstimatedFuelCost = ViewBag.EstimatedFuelCost as decimal?;

    // Diğer Değerler (int)
    int? safeTotalDays = ViewBag.TotalDays as int?;

    // Varsayılan Değerler (null ise 0 veya uygun bir değer kullanmak için)
    decimal pricePerDayVal = safePricePerDay ?? 0M;
    decimal totalPriceVal = safeTotalPrice ?? 0M;
    decimal estimatedFuelCostVal = safeEstimatedFuelCost ?? 0M;
    double distanceKmVal = safeDistanceKm ?? 0.0;
    double estimatedFuelLitersVal = safeEstimatedFuelLiters ?? 0.0;
    int totalDaysVal = safeTotalDays ?? 1;

    // Görüntüleme için yakıt tipi metni
    string fuelDisplay = ((string)ViewBag.CarInfo?.FuelType == "Elektrik" ? "kWh" : "litre");
}

<div class="card mt-4">
    <div class="card-header bg-primary text-white">
        Rezervasyon Özeti
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <h6>Seçilen Araç</h6>
                <p><strong>@ViewBag.Brand @ViewBag.Model</strong></p>
                <p>Yakıt Tipi: <strong>@ViewBag.CarInfo?.FuelType</strong></p>
                <p>₺@(pricePerDayVal.ToString("F2")) / gün</p>
            </div>
            <div class="col-md-6">
                <h6>Tarih Bilgileri</h6>

                <p>
                    Alış:
                    @if (safeStartDate.HasValue)
                    {
                        @safeStartDate.Value.ToShortDateString()
                    }
                    else
                    {
                        <span>Tarih Bilgisi Eksik</span>
                    }
                    @ViewBag.StartTime
                </p>

                <p>
                    Bırakış:
                    @if (safeEndDate.HasValue)
                    {
                        @safeEndDate.Value.ToShortDateString()
                    }
                    else
                    {
                        <span>Tarih Bilgisi Eksik</span>
                    }
                    @ViewBag.EndTime
                </p>

                <p>@totalDaysVal gün</p>
            </div>
        </div>
        <hr />
        <div class="row">
            <div class="col-md-6">
                <h6>Lokasyon</h6>
                <p>Alış: @ViewBag.PickUpText</p>
                <p>Bırakış: @ViewBag.DropOffText</p>
            </div>
            <div class="col-md-6">
                <h6>Fiyat Detayı</h6>
                <p>Günlük Ücret: ₺@(pricePerDayVal.ToString("F2"))</p>
                <p>Gün Sayısı: @totalDaysVal</p>
                <p><strong>Araç Kirası:</strong> ₺@(totalPriceVal.ToString("F2"))</p>
            </div>
        </div>
        <hr />
        <div class="row mt-3">
            <div class="col-md-6">
                <h6>Tahmini Mesafe ve Yakıt</h6>

                <p><i class="fas fa-route text-info"></i> <strong>Ortalama Mesafe:</strong> @(distanceKmVal.ToString("F1")) km</p>

                <p><i class="fas fa-gas-pump text-warning"></i> <strong>Tahmini Yakıt:</strong> @(estimatedFuelLitersVal.ToString("F1")) @fuelDisplay</p>
                <small class="text-muted">(7 lt/100km olarak hesaplanmıştır)</small>
            </div>
            <div class="col-md-6">
                <h6>Maliyet Özeti</h6>

                <div class="p-3 rounded border">
                    <div class="d-flex justify-content-between mb-2">
                        <span>Araç Kirası:</span>
                        <span class="font-weight-bold">₺@(totalPriceVal.ToString("F2"))</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Tahmini Yakıt:</span>
                        <span class="font-weight-bold">₺@(estimatedFuelCostVal.ToString("F2"))</span>
                    </div>
                    <hr class="my-2">
                    <div class="d-flex justify-content-between">
                        <span class="h6 mb-0">TOPLAM MALIYET:</span>
                        <span class="h5 mb-0 text-success font-weight-bold">₺@((totalPriceVal + estimatedFuelCostVal).ToString("F2"))</span>
                    </div>
                </div>
                <small class="text-muted mt-2 d-block">
                    <i class="fas fa-info-circle"></i> Yakıt maliyeti tahminidir, gerçek tüketim değişebilir.
                </small>
            </div>
        </div>
    </div>
</div>